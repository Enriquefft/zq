#!/usr/bin/env node
"use strict";

const { execFileSync } = require("child_process");

const PLATFORMS = {
  "linux-x64": "@zqjson/linux-x64",
  "linux-arm64": "@zqjson/linux-arm64",
  "darwin-x64": "@zqjson/darwin-x64",
  "darwin-arm64": "@zqjson/darwin-arm64",
  "win32-x64": "@zqjson/win32-x64",
  "freebsd-x64": "@zqjson/freebsd-x64",
};

const platformKey = `${process.platform}-${process.arch}`;
const pkg = PLATFORMS[platformKey];

if (!pkg) {
  console.error(
    `zq: unsupported platform ${process.platform} ${process.arch}`
  );
  process.exit(1);
}

let binPath;
try {
  binPath = require.resolve(
    `${pkg}/bin/zq${process.platform === "win32" ? ".exe" : ""}`
  );
} catch {
  console.error(
    `zq: could not find binary package ${pkg}.\n` +
      `This usually means your package manager did not install the correct optional dependency.\n` +
      `Try reinstalling with: npm install @zqjson/zq`
  );
  process.exit(1);
}

const args = process.argv.slice(2);
try {
  execFileSync(binPath, args, { stdio: "inherit" });
} catch (e) {
  process.exit(e.status ?? 1);
}
